// ASCII only: the dialog's texts are set at run time in the interface language
// (src/settings_window.rs), so the file compiles the same with windres and rc.exe whatever their
// code page.
#include <windows.h>

1 ICON "icon.ico"

// Common controls 6: themed buttons, check boxes and the hotkey field.
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "HoverCopy: copies the word under the mouse cursor"
            VALUE "ProductName", "HoverCopy"
            VALUE "FileVersion", "1.1.0"
            VALUE "ProductVersion", "1.1.0"
            VALUE "OriginalFilename", "HoverCopy.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Settings dialog; ids match src/settings_window.rs.
100 DIALOGEX 0, 0, 270, 168
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "HoverCopy"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Hotkey:", 106, 10, 13, 72, 10
    CONTROL         "", 101, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 84, 10, 176, 14
    LTEXT           "", 107, 84, 27, 176, 26
    LTEXT           "Language:", 109, 10, 61, 72, 10
    COMBOBOX        108, 84, 58, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Show toast", 102, 10, 82, 250, 10
    AUTOCHECKBOX    "Save debug", 103, 10, 100, 170, 10
    PUSHBUTTON      "Open folder", 104, 190, 97, 70, 14
    LTEXT           "", 105, 10, 120, 250, 20
    DEFPUSHBUTTON   "Save", IDOK, 146, 146, 56, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 206, 146, 56, 14
END
